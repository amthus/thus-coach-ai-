{
  "name": "thusstride",
  "private": true,
  "version": "1.0.0",
  "description": "ThusStride – coach de course à pied intelligent : plans personnalisés, zones cardiaques, suivi de la fatigue et coach IA.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:client && npm run build:server",
    "start": "node --enable-source-maps dist-server/server.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/generate-assets.mjs",
    "clean": "rm -rf dist dist-server"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "kysely": "^0.27.6",
    "lucide-react": "^0.546.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-calendar": "^6.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^7.18.5",
    "recharts": "^3.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}
