# ---------------------------------------------------------------- Application
NODE_ENV=development
PORT=3000
# Public URL of the site (used for canonical URLs, sitemap, e-mail links)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Database
# PostgreSQL connection string - REQUIRED in production (e.g. Neon, Supabase, RDS).
# When empty, a local SQLite file is used (development only).
DATABASE_URL=
DATABASE_SSL=false
SQLITE_PATH=.data/thusstride.db

# ---------------------------------------------------------------- Accounts
# Comma separated e-mails that receive the admin role when they sign up
ADMIN_EMAILS=
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- AI providers (optional)
# Without any key, plans and advice come from the built-in rules engine and the chat coach is disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_MODEL=ibm/granite-3-8b-instruct

# ---------------------------------------------------------------- E-mail (password reset)
# e.g. smtps://user:password@smtp.example.com:465 - when empty, e-mails are printed in the dev console.
SMTP_URL=
MAIL_FROM=ThusStride <no-reply@thusstride.app>

# ---------------------------------------------------------------- Legal pages (build time)
VITE_CONTACT_EMAIL=contact@thusstride.app
VITE_LEGAL_PUBLISHER=Malthus Ametepe (ThusDev)
